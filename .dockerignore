# Deny by default: do not upload the workspace, keyfiles or node state to a builder.
**
!Dockerfile
!.dockerignore
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!.npmrc
!tsconfig*.json
!artifacts/
!artifacts/api-server/
!artifacts/api-server/package.json
!artifacts/api-server/tsconfig.json
!artifacts/api-server/build.mjs
!artifacts/api-server/src/
!artifacts/api-server/src/**
!artifacts/bitcoin-vault/
!artifacts/bitcoin-vault/package.json
!artifacts/bitcoin-vault/tsconfig.json
!artifacts/bitcoin-vault/vite.config.ts
!artifacts/bitcoin-vault/index.html
!artifacts/bitcoin-vault/src/
!artifacts/bitcoin-vault/src/**
!artifacts/bitcoin-vault/public/
!artifacts/bitcoin-vault/public/**
!lib/
!lib/api-zod/
!lib/api-zod/**
!lib/api-client-react/
!lib/api-client-react/**
!lib/db/
!lib/db/**
!deploy/
!deploy/app-entrypoint.mjs
!deploy/app-config.mjs
!deploy/vault-engine.Dockerfile
!deploy/bitcoin-core.Dockerfile
!deploy/bitcoin-signet.conf
!services/
!services/vault-engine/
!services/vault-engine/*.go
!services/vault-engine/go.mod
# Final exclusions also apply to the allowed subtrees.
**/node_modules
**/dist
**/*.tsbuildinfo
**/.tsbuildinfo
**/.env*
**/.vault-data
**/*.sqlite*
**/*.key
**/*.pem
**/*.vault
**/*.test.*
**/*_test.go

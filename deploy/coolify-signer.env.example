# PRIVATE SIGNER SERVICE ONLY. Never paste these into the app service.
# Dockerfile: /deploy/vault-engine.Dockerfile; context: /; linux/amd64.
# No public domain; no Ports Mappings; port 9090 reachable only privately.
# /status requires bearer authentication: a public/unauthenticated health probe
# gets 401. No separate unauthenticated signer health route is implemented.
BITCOIN_NETWORK=signet
ENGINE_LISTEN=0.0.0.0:9090
ENGINE_DATA_DIR=/var/lib/personal-vault
# Separate random >=32-character token, same value as the APP engine token.
VAULT_ENGINE_TOKEN=
BTC_RPC_URL=http://bitcoin-core:38332
BTC_RPC_COOKIE_FILE=/run/bitcoin/signet/.cookie
COLD_DESCRIPTOR=
COLD_DESCRIPTOR_SHA256=
# Leave both absent until the Worker has been deployed and verified.
# REPLICA_URL=https://YOUR-VERIFIED-WORKER/replicate
# REPLICA_TOKEN=
# Required persistent mount: /var/lib/personal-vault, owned by UID:GID 10001:10001.
# Core's signet cookie file must be privately mounted read-only at the path above.
# Never publish Core RPC 38332 or signer 9090. No CF_API_TOKEN/SMTP_PASSWORD here.

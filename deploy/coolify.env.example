# APP SERVICE ONLY: copy these fields to Coolify as runtime-only variables.
# Empty required secrets below must be filled in Coolify, never committed here.
# Dockerfile: /Dockerfile; build context: /; architecture: linux/amd64.
# Ports Exposes: 3000; Ports Mappings: empty; no public 8080/9090/38332.
# Health: HTTP GET /api/healthz, port 3000, expected status 200.
# Interval 30s; timeout 5s; start period 30s; retries 3.
# Health is process liveness, not proof of Core/D1/SMTP availability.
NODE_ENV=production
PORT=3000
BITCOIN_NETWORK=signet
PUBLIC_ORIGIN=https://coin.scousgiftcardexchange.com
VAULT_STATIC_DIR=/app/public
VAULT_OWNER_VERIFIER=
CF_ACCOUNT_ID=3674e7d6dd7b7c18b663d40bbec82002
CF_D1_DATABASE_ID=f7f16095-2d5a-4cda-8889-94666a7bea06
CF_API_TOKEN=
# Exact IPs of verified reverse proxies, comma-separated. Blank trusts no headers.
TRUSTED_PROXY_IPS=
# Cloudflare Email Sending must be enabled and the sender domain onboarded.
# SMTP_PASSWORD: separate token with Email Sending: Edit, runtime secret only.
SMTP_HOST=smtp.mx.cloudflare.net
SMTP_PORT=465
SMTP_USER=api_token
SMTP_PASSWORD=
SECURITY_ALERT_FROM=vault@alert.scousgiftcardexchange.com
SECURITY_ALERT_TO=support@connectliveagent.com
# Enable these together only after private signer networking is verified.
# VAULT_ENGINE_URL=http://vault-engine:9090
# VAULT_ENGINE_TOKEN=
# MARKET_WORKER_URL stays unset; market permission is not established.

# SIGNER: separate service; use deploy/coolify-signer.env.example.

# WORKER: Cloudflare bindings are not Coolify environment variables.
# Install REPLICA_TOKEN as a Worker secret as well as a signer secret.
# Keep MARKET_ENABLED=false in Wrangler configuration.
# Owner login key, Bitcoin seeds, RPC cookie contents and backup key: NEVER here.
